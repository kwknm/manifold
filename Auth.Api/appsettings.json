{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "BookTracking.Auth",
    "Audience": "BookTracking",
    "AccessTokenLifetimeMinutes": 10,
    "RefreshTokenLifetimeDays": 30
  },
  "PasswordHashing": {
    "SaltSize": 16,
    "KeySize": 32,
    "Iterations": 100000,
    "Algorithm": "SHA256"
  }
}
