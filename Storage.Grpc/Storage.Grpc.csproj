<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>c93bb105-a927-48ae-a55b-f60ff4e3fc00</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Protos\storage.proto" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="CommunityToolkit.Aspire.SeaweedFS.Client" />
        <PackageReference Include="Grpc.AspNetCore"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <None Remove="Protos\files.proto" />
    </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared.Protos\Shared.Protos.csproj" />
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>
